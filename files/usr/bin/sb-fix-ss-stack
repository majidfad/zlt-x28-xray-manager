#!/bin/sh
# One-shot repair: free overlay junk, re-fetch full sb-swan.tgz onto /data,
# bind-mount into /usr/lib/ipsec, expose 5.9.2 tools via /tmp/sb-ss-bin.
# Safe to run when overlay is 100% full (bind-mount needs no free inodes).
set -e
SB_REPO_RAW="${SB_REPO_RAW:-https://raw.githubusercontent.com/majidfad/zlt-x28-xray-manager/main}"
TGZ_URL="${SB_SWAN_TGZ_URL:-${SB_REPO_RAW}/files/opt/sb-swan.tgz}"
WORK=/tmp/sb_swan_fix
IPSEC_LIB=/usr/lib/ipsec

echo "[fix-ss] === before ==="
df -h / /data 2>/dev/null || df -h /
echo "[fix-ss] overlay top users:"
du -x -d 1 / 2>/dev/null | sort -nr | head -n 15 || true
du -x -d 1 /usr/lib 2>/dev/null | sort -nr | head -n 10 || true
du -x -d 1 /etc 2>/dev/null | sort -nr | head -n 10 || true

echo "[fix-ss] stopping strongSwan..."
ipsec stop 2>/dev/null || true
/etc/init.d/ipsec stop 2>/dev/null || true
killall charon starter swanctl 2>/dev/null || true
sleep 1

if mount | grep -q " on $IPSEC_LIB "; then
    umount "$IPSEC_LIB" 2>/dev/null || umount -l "$IPSEC_LIB" 2>/dev/null || true
fi

echo "[fix-ss] freeing overlay copies / junk..."
rm -f "$IPSEC_LIB"/charon "$IPSEC_LIB"/starter "$IPSEC_LIB"/stroke \
      "$IPSEC_LIB"/libstrongswan.so.0 "$IPSEC_LIB"/libcharon.so.0 \
      "$IPSEC_LIB"/libvici.so.0 2>/dev/null || true
rm -f "$IPSEC_LIB"/plugins/*.so 2>/dev/null || true
rm -rf /opt/sb-swan /etc/singbox/ss-plugins /etc/singbox/ss-oem-ipsec-bak \
       /tmp/sb_swan_dl /tmp/sb_ss_plugins.log 2>/dev/null || true
# Truncate huge logs on overlay
for f in /var/log/singbox.log /tmp/sb_ipsec.err; do
    [ -f "$f" ] && : > "$f" 2>/dev/null || true
done
# Drop opkg lists cache if present (re-downloadable)
rm -rf /tmp/opkg-lists 2>/dev/null || true
df -h / || true

# Pick stack root on large partition
mount -o remount,rw,exec /data 2>/dev/null || true
mount -o remount,rw,exec /customer 2>/dev/null || true
OPT=""
for b in /data /customer; do
    [ -d "$b" ] || continue
    mkdir -p "$b/sb-swan" 2>/dev/null || continue
    _t="$b/sb-swan/.exectest"
    printf '#!/bin/sh\nexit 0\n' > "$_t" 2>/dev/null || continue
    chmod +x "$_t"
    if "$_t" 2>/dev/null; then
        rm -f "$_t"
        OPT="$b/sb-swan"
        break
    fi
    rm -f "$_t"
done
[ -n "$OPT" ] || {
    echo "[fix-ss] ERROR: cannot write/exec on /data or /customer" >&2
    exit 1
}
echo "[fix-ss] stack root: $OPT"

# /data on ZLT often extracts tar as 666 (no +x). Always fix modes.
fix_exec_bits() {
    _root="$1"
    echo "[fix-ss] chmod +x on stack binaries/plugins under $_root"
    chmod 755 "$_root/lib/ipsec/charon" "$_root/lib/ipsec/starter" \
              "$_root/lib/ipsec/stroke" "$_root/sbin/ipsec" \
              "$_root/sbin/swanctl" 2>/dev/null || true
    chmod 755 "$_root/lib/ipsec/"*.so* 2>/dev/null || true
    chmod 755 "$_root/lib/ipsec/plugins/"*.so 2>/dev/null || true
}

need_fetch=1
if [ -f "$OPT/lib/ipsec/charon" ] && [ -f "$OPT/sbin/swanctl" ] \
    && [ -f "$OPT/lib/ipsec/plugins/libstrongswan-x509.so" ] \
    && grep -aq '5\.9\.2' "$OPT/lib/ipsec/charon" 2>/dev/null \
    && grep -aq '5\.9\.2' "$OPT/sbin/swanctl" 2>/dev/null; then
    echo "[fix-ss] existing complete 5.9.2 tree at $OPT"
    need_fetch=0
fi

if [ "$need_fetch" = "1" ]; then
    echo "[fix-ss] downloading full tarball..."
    rm -rf "$WORK"
    mkdir -p "$WORK"
    # BusyBox wget: no -t/--tries; use -T timeout only.
    if command -v wget >/dev/null 2>&1; then
        wget -q -T 60 -O "$WORK/sb-swan.tgz" "$TGZ_URL" \
            || wget -q -T 60 --no-check-certificate -O "$WORK/sb-swan.tgz" "$TGZ_URL"
    else
        curl -fsSL --connect-timeout 15 --max-time 120 -o "$WORK/sb-swan.tgz" "$TGZ_URL"
    fi
    _sz=$(wc -c < "$WORK/sb-swan.tgz")
    echo "[fix-ss] downloaded $_sz bytes"
    [ "$_sz" -gt 10000 ] || {
        echo "[fix-ss] ERROR: download too small" >&2
        head -c 200 "$WORK/sb-swan.tgz" >&2 || true
        exit 1
    }
    rm -rf "$WORK/out"
    mkdir -p "$WORK/out"
    tar -xzf "$WORK/sb-swan.tgz" -C "$WORK/out"
    rm -rf "$OPT"
    if [ -d "$WORK/out/sb-swan" ]; then
        mv "$WORK/out/sb-swan" "$OPT"
    else
        mkdir -p "$OPT"
        mv "$WORK/out/"* "$OPT/" || true
    fi
    rm -rf "$WORK"
fi

fix_exec_bits "$OPT"

echo "[fix-ss] source tree:"
ls -la "$OPT/lib/ipsec/charon" "$OPT/sbin/swanctl" "$OPT/sbin/ipsec" \
       "$OPT/lib/ipsec/plugins/libstrongswan-x509.so" \
       "$OPT/lib/ipsec/plugins/libstrongswan-pkcs1.so" 2>&1 || true

[ -f "$OPT/lib/ipsec/charon" ] || {
    echo "[fix-ss] ERROR: charon missing in $OPT" >&2
    ls -la "$OPT/lib/ipsec" >&2 || true
    exit 1
}
[ -f "$OPT/sbin/swanctl" ] || {
    echo "[fix-ss] ERROR: swanctl missing in $OPT/sbin" >&2
    ls -la "$OPT/sbin" >&2 || true
    exit 1
}
if [ ! -x "$OPT/lib/ipsec/charon" ]; then
    echo "[fix-ss] WARN: charon still not -x after chmod; remount exec + retry"
    mount -o remount,rw,exec /data 2>/dev/null || true
    fix_exec_bits "$OPT"
fi
if [ ! -x "$OPT/lib/ipsec/charon" ]; then
    echo "[fix-ss] ERROR: cannot set execute bit on $OPT/lib/ipsec/charon" >&2
    echo "[fix-ss] mount:"; mount | grep ' /data' || mount | grep data || true
    ls -la "$OPT/lib/ipsec/charon" >&2
    exit 1
fi

echo "[fix-ss] bind-mount $OPT/lib/ipsec -> $IPSEC_LIB"
mkdir -p "$IPSEC_LIB" "$IPSEC_LIB/plugins" 2>/dev/null || true
# If mkdir failed due to full overlay but dir exists, continue
[ -d "$IPSEC_LIB" ] || {
    echo "[fix-ss] ERROR: $IPSEC_LIB missing and cannot create (overlay full?)" >&2
    exit 1
}
if mount | grep -q " on $IPSEC_LIB "; then
    umount "$IPSEC_LIB" 2>/dev/null || umount -l "$IPSEC_LIB" 2>/dev/null || true
fi
mount --bind "$OPT/lib/ipsec" "$IPSEC_LIB"
echo "[fix-ss] mounts:"
mount | grep ipsec || mount | grep sb-swan || true

echo "[fix-ss] after bind, $IPSEC_LIB:"
ls -la "$IPSEC_LIB/charon" "$IPSEC_LIB/plugins/libstrongswan-x509.so" 2>&1 || true

if [ ! -e "$IPSEC_LIB/charon" ]; then
    echo "[fix-ss] ERROR: bind-mount did not expose charon" >&2
    echo "[fix-ss] ls source:"; ls -la "$OPT/lib/ipsec" >&2 || true
    echo "[fix-ss] ls dest:"; ls -la "$IPSEC_LIB" >&2 || true
    echo "[fix-ss] readlink dest:"; ls -ld "$IPSEC_LIB" >&2 || true
    exit 1
fi

grep -aq '5\.9\.2' "$IPSEC_LIB/charon" || {
    echo "[fix-ss] ERROR: charon after bind is not 5.9.2" >&2
    exit 1
}
echo "[fix-ss] CHARON_OK (5.9.2)"

# Tools via tmpfs (no overlay needed)
mkdir -p /tmp/sb-ss-bin
ln -sf "$OPT/sbin/swanctl" /tmp/sb-ss-bin/swanctl
ln -sf "$OPT/sbin/ipsec" /tmp/sb-ss-bin/ipsec
export PATH="/tmp/sb-ss-bin:$OPT/sbin:$PATH"

echo "[fix-ss] swanctl path=$(command -v swanctl)"
# --help/--version without daemon: some builds need --raw; print binary strings too
if /tmp/sb-ss-bin/swanctl --help 2>&1 | head -n3; then
    :
fi
if grep -aq '5\.9\.2' /tmp/sb-ss-bin/swanctl 2>/dev/null; then
    echo "[fix-ss] SWANCTL_OK (binary is 5.9.2)"
else
    echo "[fix-ss] WARN: swanctl binary tag check failed"
fi

# Persist markers (best-effort if overlay has a few KB now)
mkdir -p /etc/singbox 2>/dev/null || true
echo "$OPT" > /etc/singbox/ss-stack.root 2>/dev/null || echo "$OPT" > /tmp/ss-stack.root
echo "5.9.2-ipsec18" > /etc/singbox/ss-stack.ver 2>/dev/null || true

# Persist bind on boot via rc.local append (few bytes) if possible
if [ -f /etc/rc.local ] && ! grep -q 'sb-swan/lib/ipsec' /etc/rc.local 2>/dev/null; then
    sed -i "s|^exit 0|mount -o remount,rw,exec /data 2>/dev/null; mount --bind $OPT/lib/ipsec /usr/lib/ipsec 2>/dev/null; mkdir -p /tmp/sb-ss-bin; ln -sf $OPT/sbin/swanctl /tmp/sb-ss-bin/swanctl; ln -sf $OPT/sbin/ipsec /tmp/sb-ss-bin/ipsec; exit 0|" /etc/rc.local 2>/dev/null || true
fi

# Tiny strongswan conf with x509/pkcs1 — try /tmp and /etc/singbox
CONF=/etc/singbox/strongswan.conf
cat > /tmp/strongswan.conf << 'SCONF'
charon {
    load_modular = no
    install_routes = yes
    install_virtual_ip = yes
    load = random nonce aes des rc2 sha1 sha2 md5 mgf1 hmac xcbc gmp curve25519 openssl pem pkcs1 pkcs7 pkcs8 pkcs12 x509 pubkey constraints pgp dnskey sshkey fips-prf drbg attr kernel-netlink socket-default stroke vici updown counters gcm
}
SCONF
cp -f /tmp/strongswan.conf "$CONF" 2>/dev/null || CONF=/tmp/strongswan.conf
ln -sf "$CONF" /etc/strongswan.conf 2>/dev/null || true
export STRONGSWAN_CONF="$CONF"

echo "[fix-ss] starting matched charon..."
killall charon starter 2>/dev/null || true
sleep 1
STRONGSWAN_CONF="$CONF" "$IPSEC_LIB/charon" >/tmp/sb_charon.log 2>&1 &
sleep 2
if [ -S /var/run/charon.vici ] || [ -S /var/run/charon.ctl ]; then
    echo "[fix-ss] charon socket UP"
else
    echo "[fix-ss] WARN: no vici socket yet; charon log:"
    tail -n 40 /tmp/sb_charon.log 2>/dev/null || true
fi

echo "[fix-ss] loaded plugins:"
PATH="/tmp/sb-ss-bin:$PATH" STRONGSWAN_CONF="$CONF" ipsec statusall 2>/dev/null \
    | sed -n 's/.*loaded plugins: /plugins: /p' || true

echo "[fix-ss] === after ==="
df -h / /data 2>/dev/null || true
echo "[fix-ss] DONE. Next:"
echo "  export PATH=/tmp/sb-ss-bin:$OPT/sbin:\$PATH"
echo "  export STRONGSWAN_CONF=$CONF"
echo "  Then Activate VPN in LuCI, or: sb-manager restart"
echo "  Verify: sb-manager ss_check   (after updating install.sh)"
