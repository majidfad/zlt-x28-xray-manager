#!/bin/sh
# Update sb-manager onto /data (works when overlay / is 100% full).
set -e
URL="${1:-https://raw.githubusercontent.com/majidfad/zlt-x28-xray-manager/main/files/usr/bin/sb-manager}"
mkdir -p /data/sb-bin /tmp/sb-ss-bin
echo "[update] downloading sb-manager -> /data/sb-bin/sb-manager"
if command -v wget >/dev/null 2>&1; then
    wget -q -T 60 -O /data/sb-bin/sb-manager "$URL" \
        || wget -q -T 60 --no-check-certificate -O /data/sb-bin/sb-manager "$URL"
else
    curl -fsSL -o /data/sb-bin/sb-manager "$URL"
fi
chmod +x /data/sb-bin/sb-manager
# Drop old overlay copy so symlink fits
rm -f /usr/bin/sb-manager
ln -sf /data/sb-bin/sb-manager /usr/bin/sb-manager 2>/dev/null || true
ln -sf /data/sb-bin/sb-manager /tmp/sb-ss-bin/sb-manager
echo "[update] version: $(/data/sb-bin/sb-manager version)"
echo "[update] path: $(command -v sb-manager 2>/dev/null || echo /data/sb-bin/sb-manager)"
echo "[update] OK — run: /data/sb-bin/sb-manager restart"
